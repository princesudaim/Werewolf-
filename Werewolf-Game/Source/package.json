{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/create-download.mjs",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:unit": "node scripts/test-unit.mjs",
    "test:ui": "node --experimental-strip-types --test --test-timeout=600000 tests/werewolf-ui.test.mjs",
    "test:feedback": "node --experimental-strip-types --test tests/feedback-controller.test.mjs",
    "test:browser-feedback": "node --experimental-strip-types tests/browser-feedback.mjs",
    "test:browser-motion": "node --experimental-strip-types tests/browser-motion.mjs",
    "test:browser-accessibility": "node --experimental-strip-types tests/browser-accessibility.mjs",
    "test:browser-gameplay-accessibility": "node --experimental-strip-types tests/browser-gameplay-accessibility.mjs",
    "test:browser-turn-flow": "node --experimental-strip-types tests/browser-turn-help.mjs",
    "test:browser-offline-updates": "node tests/browser-offline-updates.mjs",
    "test:recovery": "node --experimental-strip-types --test tests/match-recovery.test.mjs tests/recovery-integration.test.mjs",
    "test:browser-recovery": "node --experimental-strip-types tests/browser-recovery.mjs && node --experimental-strip-types tests/browser-recovery-deadlines.mjs && node --experimental-strip-types tests/browser-recovery-roles.mjs",
    "test:browser-file": "node tests/browser-file-smoke.mjs",
    "test:browser-cache-repair": "node --experimental-strip-types tests/browser-cache-repair.mjs",
    "test:browser-settings": "node tests/browser-settings-layout.mjs",
    "test:browser-thief": "node --experimental-strip-types tests/browser-thief.mjs",
    "test:browser-home-menu": "node tests/browser-home-menu.mjs",
    "test:browser-celebrity": "node --experimental-strip-types tests/browser-celebrity.mjs",
    "test:browser-discussion": "node --experimental-strip-types tests/browser-discussion.mjs",
    "test:browser-random-defaults": "node --experimental-strip-types tests/browser-random-defaults.mjs",
    "test:browser-voting-layout": "node tests/browser-voting-layout.mjs",
    "test:browser-compact-results": "node tests/browser-compact-results.mjs",
    "test:browser-mvp": "node --experimental-strip-types tests/browser-mvp-replay.mjs",
    "test:browser-audio": "node tests/browser-audio.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "^1.48.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "axe-core": "4.14.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.0",
    "yazl": "^3.3.1"
  }
}
